# ---------------------------------------------------------------------------
# FAKHARA API - backend environment template
# Copy to server/.env and fill in the real values.
# Placeholders only: never put a real secret in this file.
# ---------------------------------------------------------------------------

# HTTP server
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Frontend origin allowed by CORS (comma-separated list for several origins).
# In development, loopback origins on any port are also accepted automatically.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# MongoDB connection string.
# The database name is "fakhara".
# Local:  mongodb://127.0.0.1:27017/fakhara
# Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/fakhara?retryWrites=true&w=majority
#
# Start the local server with: npm run mongo
MONGODB_URI=mongodb://127.0.0.1:27017/fakhara
MONGO_DB_NAME=fakhara

# At least 32 characters. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional: password reset e-mails (Resend HTTP API).
# Without these values the reset link is printed in the server console
# and returned to the browser in development mode.
RESEND_API_KEY=
MAIL_FROM=FAKHARA <no-reply@example.com>

# Optional secret used to sign anonymous review/favorite cookies.
# If empty, a development secret is generated in server/data/.rating-secret.
FAKHARA_RATING_SECRET=

# Initial administrator. Used on first start and by npm run seed:admin.
# The password is never stored in plain text: it is hashed with bcrypt.
# Requirements: 12+ characters.
#
# Diagnostics:  npm run admin:check   (read-only, never prints the password)
# First admin:  npm run seed:admin    (only creates if no admin exists)
# Set/rotate:   update ADMIN_PASSWORD below, then run: npm run admin:reset
ADMIN_NAME=FAKHARA Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Durable image storage for production uploads (Cloudinary).
# Required in production; obtain these from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional
# FAKHARA_DATA_DIR=
# MONGO_MEMORY_DB_PATH=
# TRUST_PROXY=
