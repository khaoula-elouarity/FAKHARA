# ---------------------------------------------------------------------------
# FAKHARA frontend (Vite) environment template
# Copy to .env and adjust for your machine.
# Placeholders only: never put a real secret in this file.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the FAKHARA Express API.
# Leave empty (recommended) to use same-origin requests through the Vite dev
# proxy (/api). This keeps cookies working whether the site is opened through
# localhost or 127.0.0.1.
# Leave empty for local development (Vite proxies to localhost:5000).
# On Vercel, set VITE_API_URL=https://fakhara-backend.vercel.app/api.
VITE_API_URL=
